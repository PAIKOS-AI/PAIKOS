# Hono API Environment Variables

# Server Configuration
PORT=3001
BUN_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/paikos_db

# Redis Configuration (for quota tracking)
REDIS_URL=redis://localhost:6379

# Auth Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=900  # 15 minutes in seconds
REFRESH_TOKEN_EXPIRY=2592000  # 30 days in seconds

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OAuth (optional)
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Application Settings
NODE_ENV=development
SESSION_QUOTA_GUEST=3  # 3 sessions per day for guests
SESSION_QUOTA_FREE=5   # 5 sessions per day for free users
TOKEN_LIMIT_GUEST=8000
TOKEN_LIMIT_FREE=16000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug
